# Copy to AgentRSI/.env (gitignored) and fill in. Never commit real values.
# Never paste real keys into chat, task folders or committed files.

# Which agent and model to run (Harbor -a / -m)
AGENT=claude-code            # claude-code | codex
MODEL=                       # provider's model name

# Third-party inference gateway (Harbor --base-url / --api-key-name)
# Claude Code uses the Anthropic Messages format; Codex uses OpenAI Responses.
BASE_URL=                           # https://your-gateway.example.com
API_FORMAT=anthropic_messages       # anthropic_messages | openai_responses
API_KEY_NAME=ANTHROPIC_AUTH_TOKEN   # env var name Harbor reads the key from
API_KEY=                            # real key goes ONLY here, in the gitignored .env

# Runtime (rootful Podman from WSL)
ENV=podman
CONTAINER_HOST=unix:///mnt/wsl/podman-sockets/podman-machine-default/podman-root.sock

# Google Cloud (GEE / GCS). The service-account JSON stays on disk, never in chat.
GCP_PROJECT=
GCP_SA_KEY_PATH=             # e.g. /home/{USER}/GitRepo/SAR-OilPalm-Detection/AgentRSI/.secrets/gcp-sa.json

# Spend guards
DAILY_SPEND_CAP_USD=
